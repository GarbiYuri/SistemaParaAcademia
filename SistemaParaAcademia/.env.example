# Rede Docker onde a stack será conectada.
# Se a rede não existir, o compose cria automaticamente.
# Para usar uma rede já criada (ex.: cloudflare_net), ajuste:
#   NETWORK_NAME=cloudflare_net
#   NETWORK_EXTERNAL=true
NETWORK_NAME=academia_net
NETWORK_EXTERNAL=false

# Cria as contas de demonstração da tela de login (senha "senha123").
# Use false em produção.
SEED_DEMO_USERS=true

# Credenciais de inicialização do MySQL (lidas pelo docker-compose).
# Copie este arquivo para .env e ajuste os valores.
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=escola
MYSQL_USER=academia
MYSQL_PASSWORD=academia_dev_password

# Chave Fernet (32 bytes em base64 url-safe) usada para criptografar o CPF.
# Se ficar vazia, o docker-compose usa uma chave de desenvolvimento.
# Gere uma nova com:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=

# Usado apenas ao rodar o backend fora do Docker (uvicorn local).
DB_HOST=localhost
DB_PORT=3306
DB_USER=academia
DB_PASSWORD=academia_dev_password
DB_NAME=escola
